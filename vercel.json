{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "*.webp", "use": "@vercel/static" },
    { "src": "*.svg", "use": "@vercel/static" },
    { "src": "*.ico", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/login/?", "dest": "/index.html" },
    { "src": "/signup/?", "dest": "/signup.html" },
    { "src": "/marketplace/?", "dest": "/marketplace.html" },
    { "src": "/caregiver-dashboard/?", "dest": "/caregiver-dashboard.html" },
    { "src": "/employer-dashboard/?", "dest": "/employer-dashboard.html" },
    { "src": "/find-care/?", "dest": "/find-care.html" },
    { "src": "/find-jobs/?", "dest": "/find-jobs.html" },
    { "src": "/services/?", "dest": "/services.html" },
    { "src": "/privacy/?", "dest": "/privacy.html" },
    {
      "src": "/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    }
  ]
}
